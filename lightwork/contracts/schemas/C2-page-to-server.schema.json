        "id",
        "x",
        "y",
        "size"
      ],
      "title": "MarkerRect",
      "type": "object"
    },
    "Tts": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "start",
            "end",
            "error"
          ],
          "title": "State",
          "type": "string"
        },
        "type": {
