  "discriminator": {
    "mapping": {
      "ack": "#/$defs/Ack",
      "hello": "#/$defs/Hello",
      "tts": "#/$defs/Tts"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Hello"
    },
    {
      "$ref": "#/$defs/Ack"
    },
    {
      "$ref": "#/$defs/Tts"
    }
  ]
