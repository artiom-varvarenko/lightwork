{
  "$defs": {
    "Arrow": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "A",
          "type": "array"
        },
        "b": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "B",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "arrow",
          "default": "arrow",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "enum": [
            "target",
            "source",
            "error",
            "warn",
            "done",
            "info"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "id",
        "a",
        "b",
        "role"
      ],
      "title": "Arrow",
      "type": "object"
    },
    "Calib": {
      "additionalProperties": false,
      "properties": {
        "H_cam_to_page": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "H Cam To Page",
          "type": "array"
        },
        "page_size": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Page Size",
          "type": "array"
        },
        "type": {
          "const": "calib",
          "default": "calib",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "H_cam_to_page",
        "page_size"
      ],
      "title": "Calib",
      "type": "object"
    },
    "Dot": {
      "additionalProperties": false,
      "properties": {
        "c": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "C",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "dot",
          "default": "dot",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "enum": [
            "target",
            "source",
            "error",
            "warn",
            "done",
            "info"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "id",
        "c",
        "role"
      ],
      "title": "Dot",
      "type": "object"
    },
    "Label": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "At",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "label",
          "default": "label",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "enum": [
            "target",
            "source",
            "error",
            "warn",
            "done",
            "info"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type_ms": {
          "default": 0,
          "maximum": 5000,
          "minimum": 0,
          "title": "Type Ms",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "at",
        "text",
        "role"
      ],
      "title": "Label",
      "type": "object"
    },
    "MapView": {
      "additionalProperties": false,
      "description": "A live 3D map the page draws itself over a rect (MapLibre GL, web/js/tablemap.js): the scene says only where it\ngoes and what its camera shows. ``corners`` as in :class:`Picture`, ``center`` is [lon, lat]. A new ``flight`` number\nmeans fly there over ``fly_ms``; otherwise the camera jumps to it, so hands move it directly.",
      "properties": {
        "bearing": {
          "title": "Bearing",
          "type": "number"
        },
        "center": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Center",
          "type": "array"
        },
        "corners": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Corners",
          "type": "array"
        },
        "flight": {
          "default": 0,
          "title": "Flight",
          "type": "integer"
        },
        "fly_ms": {
          "default": 0,
          "maximum": 20000,
          "minimum": 0,
          "title": "Fly Ms",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "map",
          "default": "map",
          "title": "Kind",
          "type": "string"
        },
        "pitch": {
          "maximum": 75.0,
          "minimum": 0.0,
          "title": "Pitch",
          "type": "number"
        },
        "zoom": {
          "maximum": 22.0,
          "minimum": 0.0,
          "title": "Zoom",
          "type": "number"
        }
      },
      "required": [
        "id",
        "corners",
        "center",
        "zoom",
        "bearing",
        "pitch"
      ],
      "title": "MapView",
      "type": "object"
    },
    "MarkerRect": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "size": {
          "title": "Size",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "size"
      ],
      "title": "MarkerRect",
      "type": "object"
    },
    "Pattern": {
      "additionalProperties": false,
      "properties": {
        "aruco_dict": {
          "const": "DICT_4X4_50",
          "default": "DICT_4X4_50",
          "title": "Aruco Dict",
          "type": "string"
        },
        "markers": {
          "items": {
            "$ref": "#/$defs/MarkerRect"
          },
          "title": "Markers",
          "type": "array"
        }
      },
      "required": [
        "markers"
      ],
      "title": "Pattern",
      "type": "object"
    },
    "Picture": {
      "additionalProperties": false,
      "description": "A picture the page loads by URL from this server. Scenes go out up to 30 times a second, so they never carry its\nbytes. Black in it is no light on the table. Drawn under the other prims of its scene if it comes first.",
      "properties": {
        "corners": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Corners",
          "type": "array"
        },
        "draw_ms": {
          "default": 0,
          "maximum": 5000,
          "minimum": 0,
          "title": "Draw Ms",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "picture",
          "default": "picture",
          "title": "Kind",
          "type": "string"
        },
        "src": {
          "pattern": "^/pictures/[0-9a-f]{16,64}\\.(png|jpg)$",
          "title": "Src",
          "type": "string"
        }
      },
      "required": [
        "id",
        "src",
        "corners"
      ],
      "title": "Picture",
      "type": "object"
    },
    "Poly": {
      "additionalProperties": false,
      "properties": {
        "closed": {
          "title": "Closed",
          "type": "boolean"
        },
        "draw_ms": {
          "default": 0,
          "maximum": 5000,
          "minimum": 0,
          "title": "Draw Ms",
          "type": "integer"
        },
        "glow": {
          "default": false,
          "title": "Glow",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "poly",
          "default": "poly",
          "title": "Kind",
          "type": "string"
        },
        "pts": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "title": "Pts",
          "type": "array"
        },
        "role": {
          "enum": [
            "target",
            "source",
            "error",
            "warn",
            "done",
            "info"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "id",
        "pts",
        "closed",
        "role"
      ],
      "title": "Poly",
      "type": "object"
    },
    "Ring": {
      "additionalProperties": false,
      "properties": {
        "c": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "C",
          "type": "array"
        },
        "glow": {
          "default": false,
          "title": "Glow",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "ring",
          "default": "ring",
          "title": "Kind",
          "type": "string"
        },
        "pulse": {
          "default": false,
          "title": "Pulse",
          "type": "boolean"
        },
        "r": {
          "title": "R",
          "type": "number"
        },
        "role": {
          "enum": [
            "target",
            "source",
            "error",
            "warn",
            "done",
            "info"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "id",
        "c",
        "r",
        "role"
      ],
      "title": "Ring",
      "type": "object"
    },
    "SayMsg": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "default": "normal",
          "enum": [
            "normal",
            "interrupt"
          ],
          "title": "Priority",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "say",
          "default": "say",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "SayMsg",
      "type": "object"
    },
    "SceneMsg": {
      "additionalProperties": false,
      "properties": {
        "banner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Banner"
        },
        "mode": {
          "enum": [
            "normal",
            "pattern",
            "dark",
            "grey",
            "white"
          ],
          "title": "Mode",
          "type": "string"
        },
        "pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pattern"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prims": {
          "items": {
            "discriminator": {
              "mapping": {
                "arrow": "#/$defs/Arrow",
                "dot": "#/$defs/Dot",
                "label": "#/$defs/Label",
                "map": "#/$defs/MapView",
                "picture": "#/$defs/Picture",
                "poly": "#/$defs/Poly",
                "ring": "#/$defs/Ring",
                "solid": "#/$defs/Solid3D"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Ring"
              },
              {
                "$ref": "#/$defs/Arrow"
              },
              {
                "$ref": "#/$defs/Poly"
              },
              {
                "$ref": "#/$defs/Dot"
              },
              {
                "$ref": "#/$defs/Label"
              },
              {
                "$ref": "#/$defs/Picture"
              },
              {
                "$ref": "#/$defs/MapView"
              },
              {
                "$ref": "#/$defs/Solid3D"
              }
            ]
          },
          "title": "Prims",
          "type": "array"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "scene",
          "default": "scene",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "mode",
        "prims"
      ],
      "title": "SceneMsg",
      "type": "object"
    },
    "Sfx": {
      "additionalProperties": false,
      "description": "A short synthesized UI sound on the speaking page (projector, else screen); pages without sound ignore it.",
      "properties": {
        "gain": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Gain",
          "type": "number"
        },
        "name": {
          "enum": [
            "scan",
            "found",
            "press",
            "gone",
            "error",
            "listen",
            "answer"
          ],
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "sfx",
          "default": "sfx",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Sfx",
      "type": "object"
    },
    "Solid3D": {
      "additionalProperties": false,
      "description": "A 3D model the page loads once by URL (too much to send 30 times a second) and draws itself over a rect with Three.js\n(web/js/solid.js). A scene only says how it is seen: from ``dist`` model units away, small enough to be inside it,\nlooking at ``target``, turned by ``yaw`` and from ``tilt`` above. ``cut``: what lies beyond this along axis ``cut_axis``\nis sliced away; ``only``: the name of the one part left solid.",
      "properties": {
        "corners": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Corners",
          "type": "array"
        },
        "cut": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cut"
        },
        "cut_axis": {
          "default": 0,
          "enum": [
            0,
            1,
            2
          ],
          "title": "Cut Axis",
          "type": "integer"
        },
        "dist": {
          "exclusiveMinimum": 0.0,
          "title": "Dist",
          "type": "number"
        },
        "draw_ms": {
          "default": 0,
          "maximum": 8000,
          "minimum": 0,
          "title": "Draw Ms",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "solid",
          "default": "solid",
          "title": "Kind",
          "type": "string"
        },
        "only": {
          "default": "",
          "title": "Only",
          "type": "string"
        },
        "src": {
          "pattern": "^/pictures/[0-9a-f]{16,64}\\.json$",
          "title": "Src",
          "type": "string"
        },
        "target": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Target",
          "type": "array"
        },
        "tilt": {
          "title": "Tilt",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "id",
        "src",
        "corners",
        "yaw",
        "tilt",
        "dist",
        "target"
      ],
      "title": "Solid3D",
      "type": "object"
    },
    "View": {
      "additionalProperties": false,
      "description": "How the projector page turns everything it draws, pattern included: ``rotate: 180`` reads right from the far side\nof a table. Page CSS px (``Calib.page_size``, ``Ack.drawn``) stay in the page's own, unturned frame, so a mapping\nsolved from a turned pattern already contains the turn. Sent on connect and on change; screen pages ignore it.",
      "properties": {
        "rotate": {
          "default": 0,
          "enum": [
            0,
            180
          ],
          "title": "Rotate",
          "type": "integer"
        },
        "smooth": {
          "default": false,
          "title": "Smooth",
          "type": "boolean"
        },
        "type": {
          "const": "view",
          "default": "view",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "View",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "calib": "#/$defs/Calib",
      "say": "#/$defs/SayMsg",
      "scene": "#/$defs/SceneMsg",
      "sfx": "#/$defs/Sfx",
      "view": "#/$defs/View"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Calib"
    },
    {
      "$ref": "#/$defs/SceneMsg"
    },
    {
      "$ref": "#/$defs/SayMsg"
    },
    {
      "$ref": "#/$defs/Sfx"
    },
    {
      "$ref": "#/$defs/View"
    }
  ]
}
