data: {"item":{"content":[{"annotations":[],"logprobs":[],"text":"{\"code\": \"def interp(z, table):\\n    if z <= table[0][0]:\\n        return table[0][1]\\n    for i in range(1, len(table)):\\n        if z <= table[i][0]:\\n            za = table[i - 1][0]\\n            zb = table[i][0]\\n            va = table[i - 1][1]\\n            vb = table[i][1]\\n            return va + (vb - va) * (z - za) / (zb - za)\\n    return table[-1][1]\\n\\nofft = [(0, 54), (30, 46), (57, 37), (85, 29), (115, 24), (160, 19), (210, 14), (276, 9), (300, 7)]\\nwidt = [(0, 7.0), (57, 5.0), (115, 3.4), (200, 2.4), (276, 1.8)]\\nzs = [0, 9, 18, 27, 36, 45, 52, 57, 66, 76, 86, 96, 106, 115, 128, 142, 157, 173, 190, 208, 227, 247, 262, 276]\\nsigns = [-1, 1]\\n\\npart('foundation', '#d8d8d8')\\nfor sx in signs:\\n    for sy in signs:\\n        box((sx * 54, sy * 54, 1.5), (22, 22, 3))\\n        box((sx * 54, sy * 54, 4), (16, 16, 2))\\n\\npart('legs', '#e08a45')\\nlegchords = []\\nfor sx in signs:\\n    for sy in signs:\\n        chords = []\\n        for dx in signs:\\n            for dy in signs:\\n                pts = []\\n                for z in zs:\\n                    o = interp(z, offt)\\n                    w = interp(z, widt)\\n                    pts.append((sx * o + dx * w, sy * o + dy * w, z))\\n                chords.append(pts)\\n                for i in range(len(pts) - 1):\\n                    beam(pts[i], pts[i + 1], 1.15)\\n        legchords.append(chords)\\n\\npart('lattice', '#ffb060')\\nfor chords in legchords:\\n    for i in range(len(zs) - 1):\\n        for a in range(4):\\n            b = (a + 1) % 4\\n            line([chords[a][i], chords[b][i], chords[b][i + 1], chords[a][i + 1], chords[a][i]])\\n            line([chords[a][i], chords[b][i + 1]])\\n            line([chords[b][i], chords[a][i + 1]])\\n\\npart('belts', '#c96f32')\\nfor z in [18, 36, 57, 76, 96, 115, 142, 173, 208, 247, 276]:\\n    o = interp(z, offt)\\n    w = interp(z, widt)\\n    e = o + w\\n    for s in signs:\\n        beam((-e, s * e, z), (e, s * e, z), 1.0)\\n        beam((s * e, -e, z), (s * e, e, z), 1.0)\\n    for i in range(len(zs) - 1):\\n        pass\\nfor i in range(0, len(zs) - 1, 2):\\n    za = zs[i]\\n    zb = zs[i + 1]\\n    oa = interp(za, offt) + interp(za, widt)\\n    ob = interp(zb, offt) + interp(zb, widt)\\n    for s in signs:\\n        line([(-oa, s * oa, za), (ob, s * ob, zb)])\\n        line([(oa, s * oa, za), (-ob, s * ob, zb)])\\n        line([(s * oa, -oa, za), (s * ob, ob, zb)])\\n        line([(s * oa, oa, za), (s * ob, -ob, zb)])\\n\\npart('arches', '#f09a50')\\nfor face in range(4):\\n    pts = []\\n    for k in range(25):\\n        ang = math.pi * k / 24\\n        x = 52 * math.cos(ang)\\n        z = 5 + 31 * math.sin(ang)\\n        y = -(interp(z, offt) + interp(z, widt) + 1)\\n        if face == 0:\\n            pts.append((x, y, z))\\n        elif face == 1:\\n            pts.append((x, -y, z))\\n        elif face == 2:\\n            pts.append((y, x, z))\\n        else:\\n            pts.append((-y, x, z))\\n    tube(pts, 1.7, 10)\\n    pts2 = [(p[0] * 0.92, p[1] * 0.92, p[2] - 2.5) if face < 2 else (p[0] * 0.92, p[1] * 0.92, p[2] - 2.5) for p in pts]\\n    line(pts2)\\n\\npart('first floor', '#8fd8ff')\\nbox((0, 0, 57), (72, 72, 3))\\nbox((0, 0, 59.2), (58, 58, 1.2))\\nbox((0, 0, 55.2), (66, 66, 1.2))\\n\\npart('second floor', '#8fd8ff')\\nbox((0, 0, 115), (48, 48, 3))\\nbox((0, 0, 117.2), (36, 36, 1.2))\\nbox((0, 0, 113.2), (42, 42, 1.2))\\n\\npart('third floor', '#8fd8ff')\\nbox((0, 0, 276), (22, 22, 3))\\nbox((0, 0, 278.2), (17, 17, 1.2))\\n\\npart('pavilions', '#fff2a0')\\nbox((-18, -14, 63), (20, 14, 6))\\nbox((17, 15, 63), (18, 12, 6))\\nbox((0, 16, 120), (16, 10, 5))\\nbox((-13, -12, 120), (14, 10, 5))\\nbox((0, 0, 281), (12, 12, 5))\\ncylinder((-18, -14, 66), (-18, -14, 68), 5, 3)\\ncylinder((17, 15, 66), (17, 15, 68), 4.5, 2.5)\\n\\npart('restaurant', '#ff7f9f')\\nfor x in [-24, -8, 8, 24]:\\n    for y in [-24, 0, 24]:\\n        cylinder((x, y, 60), (x, y, 61), 1.6)\\n        cylinder((x, y, 59.8), (x, y, 60), 0.3)\\nfor x in [-10, 0, 10]:\\n    cylinder((x, -8, 118), (x, -8, 119), 1.3)\\n    cylinder((x, 8, 118), (x, 8, 119), 1.3)\\n\\npart('summit', '#e08a45')\\nrings = []\\nfor z, h in [(276, 10), (284, 8), (292, 6.2), (300, 4.8), (307, 3.6), (312, 2.8)]:\\n    rings.append([(h, h, z), (-h, h, z), (-h, -h, z), (h, -h, z)])\\nloft(rings)\\nbox((0, 0, 302), (11, 11, 2))\\nbox((0, 0, 290), (15, 15, 2))\\nfor sx in signs:\\n    for sy in signs:\\n        beam((sx * 9, sy * 9, 276), (sx * 3, sy * 3, 312), 0.9)\\n\\npart('antenna', '#ffffff')\\ncylinder((0, 0, 312), (0, 0, 330), 0.55, 0.18)\\ncylinder((0, 0, 318), (0, 0, 324), 1.1, 0.7)\\nbox((0, 0, 321), (5, 0.5, 0.5))\\nbox((0, 0, 326), (3.5, 0.4, 0.4))\\n\\npart('beacon', '#ffff66')\\nsphere((0, 0, 314), 1.8)\\nsphere((0, 0, 330.5), 0.7)\\n\\npart('elevators', '#7fffd4')\\ncylinder((0, 0, 57), (0, 0, 276), 1.6)\\ncylinder((2.8, 0, 115), (2.8, 0, 276), 1.1)\\nbox((0, 0, 92), (4.5, 4.5, 7))\\nbox((0, 0, 190), (4.2, 4.2, 6.5))\\nbox((2.8, 0, 250), (3.4, 3.4, 5.5))\\nfor sx, sy in [(1, 1), (-1, -1), (1, -1)]:\\n    pts = []\\n    for z in [2, 20, 40, 57, 75, 95, 115]:\\n        o = interp(z, offt)\\n        pts.append((sx * o, sy * o, z))\\n    tube(pts, 1.25, 8)\\n    oz = interp(45, offt)\\n    box((sx * interp(62, offt), sy * interp(62, offt), 62), (4, 4, 6))\\n\\npart('stairs', '#ffe97f')\\npts = []\\nfor k in range(121):\\n    ang = k * 0.55\\n    z = 115 + k * 1.34\\n    pts.append((5.2 * math.cos(ang), 5.2 * math.sin(ang), z))\\ntube(pts, 0.38, 6)\\npts = []\\nfor k in range(61):\\n    ang = k * 0.55\\n    z = 4 + k * 0.88\\n    pts.append((interp(z, offt) - 9 + 2.2 * math.cos(ang), -interp(z, offt) + 9 + 2.2 * math.sin(ang), z))\\ntube(pts, 0.35, 6)\\nfor k in range(0, 120, 4):\\n    ang = k * 0.55\\n    z = 115 + k * 1.34\\n    box((5.2 * math.cos(ang), 5.2 * math.sin(ang), z - 0.4), (2.4, 2.4, 0.35))\\n\\npart('railings', '#ffffff')\\nfor z, h in [(60.5, 36), (118.5, 24), (279.5, 11)]:\\n    line([(h, h, z), (-h, h, z), (-h, -h, z), (h, -h, z), (h, h, z)])\\n    line([(h, h, z - 1.4), (-h, h, z - 1.4), (-h, -h, z - 1.4), (h, -h, z - 1.4), (h, h, z - 1.4)])\\n    for sx in signs:\\n        for sy in signs:\\n            line([(sx * h, sy * h, z - 1.6), (sx * h, sy * h, z + 0.4)])\\nfor z, h in [(60.5, 29), (118.5, 18)]:\\n    line([(h, h, z), (-h, h, z), (-h, -h, z), (h, -h, z), (h, h, z)])\\n\", \"name\": \"Eiffel Tower\"}","type":"output_text"}],"id":"msg_01a1a874401d71b990887456b4d14137","role":"assistant","status":"completed","type":"message"},"output_index":1,"sequence_number":359,"type":"response.output_item.done"}

