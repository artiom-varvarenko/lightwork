data: {"item":{"content":[{"annotations":[],"logprobs":[],"text":"{\"code\": \"def river_y(x):\\n    return 14*math.sin(x*0.018+0.4)-4\\ndef near(x,y,pts,d):\\n    for (px,py) in pts:\\n        if (x-px)*(x-px)+(y-py)*(y-py)<d*d:\\n            return True\\n    return False\\nlandmarks=[(-80,-28),(-85,38),(-12,8),(38,-1),(28,58),(32,-30),(-42,-14),(-38,-48),(0,28)]\\npart('ground','#7fae5a')\\nbox((0,0,-2),(230,140,4))\\nbox((0,58,-1),(230,24,2))\\npart('Seine river','#35c4e8')\\nfor i in range(28):\\n    x=-112+i*8\\n    y=river_y(x)\\n    yaw=math.atan2(river_y(x+4)-river_y(x-4),8)\\n    box((x,y,-0.2),(9,13,1.2),yaw)\\npart('island','#8fc46a')\\nextrude([(22,-6),(30,-9),(48,-8),(54,-3),(48,3),(28,4),(22,1)],0,2)\\npart('bridges','#e8e0c8')\\nfor bx in [-78,-55,-38,-18,2,28,42,58,82]:\\n    by=river_y(bx)\\n    box((bx,by,2.2),(4,24,1.6))\\n    cylinder((bx-1.6,by-10,1),(bx-1.6,by+10,1),0.5)\\n    cylinder((bx+1.6,by-10,1),(bx+1.6,by+10,1),0.5)\\n    sphere((bx,by-11,3),1.2)\\n    sphere((bx,by+11,3),1.2)\\npart('streets','#d8d2b8')\\nfor i in range(14):\\n    t=i/13\\n    x=-82+t*62\\n    y=36-t*24\\n    box((x,y,0.3),(7,5,0.5),-0.36)\\nfor i in range(12):\\n    box((-80+i*3, -28+river_y(-80+i*3)*0+18-i*0.2,0.3),(4,34,0.4))\\n    break\\nbox((10,0,0.3),(120,5,0.5),0.05)\\nbox((30,-2,0.3),(5,70,0.5))\\nbox((-10,-45,0.3),(150,5,0.5))\\npart('Haussmann buildings','#f2ddaa')\\nfor gx in range(-10,11):\\n    for gy in range(-6,7):\\n        x=gx*10+((gy%3)-1)*2\\n        y=gy*10+((gx%2)*3)\\n        if abs(y-river_y(x))<13 or near(x,y,landmarks,15):\\n            continue\\n        h=7+2.5*abs(math.sin(gx*3.1+gy*1.7))\\n        box((x,y,h/2),(8,7,h))\\npart('mansard roofs','#7fb0d8')\\nfor gx in range(-10,11):\\n    for gy in range(-6,7):\\n        x=gx*10+((gy%3)-1)*2\\n        y=gy*10+((gx%2)*3)\\n        if abs(y-river_y(x))<13 or near(x,y,landmarks,15):\\n            continue\\n        h=7+2.5*abs(math.sin(gx*3.1+gy*1.7))\\n        box((x,y,h+0.8),(7,6,1.6))\\npart('Eiffel Tower','#ff8830')\\ncx,cy=-80,-28\\nfor sx in (-1,1):\\n    for sy in (-1,1):\\n        tube([(cx+sx*10,cy+sy*10,0),(cx+sx*7,cy+sy*7,10),(cx+sx*4,cy+sy*4,22),(cx+sx*1.6,cy+sy*1.6,36)],0.8,8)\\nbox((cx,cy,14),(13,13,1.8))\\nbox((cx,cy,26),(9,9,1.6))\\nbox((cx,cy,38),(5,5,1.5))\\ncylinder((cx,cy,38),(cx,cy,52),1.8,0.9)\\ncylinder((cx,cy,52),(cx,cy,62),0.35,0.05)\\nfor z in (6,18,30):\\n    s=10-z*0.24\\n    line([(cx-s,cy-s,z),(cx+s,cy+s,z),(cx+s,cy-s,z),(cx-s,cy+s,z),(cx-s,cy-s,z)])\\npart('Arc de Triomphe','#ffe9b0')\\nax,ay=-85,38\\nbox((ax-5,ay,7),(3.5,10,14))\\nbox((ax+5,ay,7),(3.5,10,14))\\nbox((ax,ay,16),(14,11,5))\\nbox((ax,ay,19.5),(11,8,2))\\nfor a in range(12):\\n    t=a/11*6.28\\n    cylinder((ax+math.cos(t)*18,ay+math.sin(t)*18,0.4),(ax+math.cos(t)*18,ay+math.sin(t)*18,1.2),0.5)\\npart('Louvre palace','#ffd977')\\nlx,ly=-12,8\\nbox((lx-14,ly,5),(22,5,10))\\nbox((lx+2,ly-11,5),(5,18,10))\\nbox((lx+2,ly+11,5),(5,18,10))\\nbox((lx+14,ly,5),(10,5,10))\\nbox((lx-14,ly,10.7),(23,6,1.4))\\nbox((lx+2,ly-11,10.7),(6,19,1.4))\\nbox((lx+2,ly+11,10.7),(6,19,1.4))\\npart('Louvre pyramid','#55e6ff')\\ncylinder((lx-2,ly,1),(lx-2,ly,13),10,0,4)\\npart('Notre Dame','#f5eeda')\\nnx,ny=38,-1\\nbox((nx,ny,6),(24,8,12))\\nbox((nx,ny,7),(8,14,14))\\nbox((nx-13,ny-3,11),(4,4,22))\\nbox((nx-13,ny+3,11),(4,4,22))\\nbox((nx-13,ny,23),(4,9,2))\\ncylinder((nx+2,ny,12),(nx+2,ny,26),1.2,0.1,8)\\ntorus((nx-15.2,ny,14),2.2,0.5,(1,0,0))\\nfor s in (-1,1):\\n    for i in range(4):\\n        beam((nx-6+i*5,ny+s*4,4),(nx-6+i*5,ny+s*8,10),0.5)\\npart('Sacre Coeur','#ffffff')\\nsphere((28,58,3),22,20,(1,0.35,0.18))\\nbox((28,55,10),(16,9,9))\\nsphere((28,55,17),5.5,16,(1,1,1.3))\\ncylinder((28,55,22),(28,55,27),1,0.2,8)\\nfor dx in (-6,6):\\n    sphere((28+dx,55,14),3,12,(1,1,1.2))\\n    cylinder((22,48,8),(22,48,18),1.6,1.2,8)\\n    break\\nbox((22,48,18),(4,4,2))\\npart('Pantheon','#ffe6a8')\\npx,py=32,-30\\nbox((px,py,5),(16,12,10))\\nfor i in range(6):\\n    cylinder((px-10,py-6+i*2.4,0),(px-10,py-6+i*2.4,9),0.6)\\nbox((px-10,py,10),(3,13,2))\\ncylinder((px,py,10),(px,py,15),6,6)\\nsphere((px,py,17),5.5,16,(1,1,0.8))\\ncylinder((px,py,21),(px,py,26),0.6,0.1,8)\\npart('Invalides','#ffcf4d')\\nbox((-42,-14,4),(26,9,8))\\ncylinder((-42,-14,8),(-42,-14,13),5,5)\\nsphere((-42,-14,16),5,16,(1,1,1.1))\\ncylinder((-42,-14,21),(-42,-14,27),0.5,0.05,8)\\nbox((-42,-14,1),(34,14,1))\\npart('Montparnasse tower','#c090ff')\\nbox((-38,-48,22),(10,10,44))\\nbox((-38,-48,45),(11,11,2))\\npart('gardens','#3fd66a')\\nbox((-52,-2,0.6),(38,12,1))\\nbox((-80,-12,0.6),(18,20,1))\\nbox((58,22,0.6),(28,18,1))\\npart('trees','#22cc55')\\nfor i in range(18):\\n    x=-68+i*4\\n    y=34-i*2.5\\n    cylinder((x,y,0),(x,y,3),0.3)\\n    sphere((x,y,5),2)\\nfor i in range(10):\\n    for s in (-1,1):\\n        x=-60+i*4\\n        cylinder((x,-2+s*5,0),(x,-2+s*5,3),0.3)\\n        sphere((x,-2+s*5,5),1.8)\\nfor i in range(8):\\n    x=-88+i*3\\n    cylinder((x,-14,0),(x,-14,2.5),0.3)\\n    sphere((x,-14,4.5),1.6)\\n\", \"name\": \"Paris landmarks\"}","type":"output_text"}],"id":"msg_01a1a8763c6374ffba12fb32531cb0b6","role":"assistant","status":"completed","type":"message"},"output_index":1,"sequence_number":428,"type":"response.output_item.done"}

