# Copy to .env and fill in. Never commit .env. Replay, verify, audit and export need none of these.

# Meta Model API (live mode). Format LLM_<digits>_<secret>.
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# Backend for verdict/ground/author/why: meta | glimmer
LW_BACKEND=meta

# Chat backend (OpenAI-compatible). Glimmer on llama.cpp via the SSH tunnel to the Mac Studio, e.g.
#   LW_CHAT_BASE_URL=http://127.0.0.1:8080/v1   LW_CHAT_MODEL=muse-glimmer
LW_CHAT_BASE_URL=
LW_CHAT_API_KEY=
LW_CHAT_MODEL=

# Dev stand-ins (PLAN.md D15): non-Meta chat models, development only. Runs go to runs-dev/ with
# provenance "dev-standin"; never committed, never after the freeze. Set to 1 to allow.
LW_DEV_ALLOW_NON_META=0

# Hard spend cap in USD for Meta API calls (persisted counter in .lightwork/).
LW_BUDGET_USD=120
